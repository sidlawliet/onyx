# ==========================================
# InvestOps AI - Global Environment Config
# ==========================================

# 1. Application & Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_NAME="InvestOps AI Institutional Control Plane"

# 2. Database (PostgreSQL 16)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=investops
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/investops

# 3. Security & Authentication (JWT)
JWT_SECRET_KEY=super-secret-investops-institutional-jwt-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# 4. LLM Providers & Agent Orchestration
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-api03-mock-key-replace-in-production
OPENAI_API_KEY=sk-proj-mock-key-replace-in-production
MOCK_LLM_RESPONSES=true

# 5. Integration Connectors
SEC_EDGAR_USER_AGENT="InvestOps AI Compliance Team compliance@investops.ai"
MOCK_BROKER_EXECUTION=true
BROKER_SANDBOX_API_KEY=sbx-key-9921-investops

# 6. Next.js Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_TELEMETRY_DISABLED=1

# 7. Cloud Deployment Target Variables (Railway & Vercel)
RAILWAY_STATIC_URL=
VERCEL_URL=
